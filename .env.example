# Deployment environment (development, staging, production)
APP_ENV=

# Host interface to bind Uvicorn ASGI server (default: 0.0.0.0)
API_HOST=

# Port for FastAPI microservice (default: 8000)
API_PORT=

# Target port for Google Cloud Run container deployment (default: 8000)
PORT=

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=

# Path to directory containing serialized .joblib model artifacts (default: models)
MODEL_DIR=

# PostgreSQL host for raw campaign metrics store (optional warehouse)
DB_HOST=

# PostgreSQL port (default: 5432)
DB_PORT=

# PostgreSQL database name (default: marketing_campaign)
DB_NAME=

# PostgreSQL username (default: postgres)
DB_USER=

# PostgreSQL password
DB_PASSWORD=
